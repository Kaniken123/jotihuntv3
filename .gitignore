node_modules

# Environment files — contain secrets (JWT_SECRET etc). NEVER commit.
# .env.example stays tracked (different filename) as the documented template.
.env

backend/database/*.db
backend/database/*.db-journal
backend/database/*.db-shm
backend/database/*.db-wal
.claude/
mobile/build_*.log
mobile/.expo/

# Built mobile APKs — large binaries, distributed out-of-band (not via git)
*.apk

# Runtime user uploads (hunt photos) — not source, kept on the server
backend/uploads/

# Build artifacts — regenerated on the server during deploy, never commit
# (tracking these makes `git pull` fail after the server rebuilds them).
backend/dist/
frontend/dist/
